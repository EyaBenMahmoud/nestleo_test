#!/usr/bin/env node

/**
 * Module dependencies.
 */
var app = require('../app');
var debug = require('debug')('backend:server');
var http = require('http');
var https = require('https');  // Add HTTPS module
var fs = require('fs');
var path = require('path');

/**
 * Get port from environment and store in Express.
 */
var port = normalizePort(process.env.PORT || '8005');
app.set('port', port);

/**
 * Create HTTPS server with SSL certificates.
 */
var sslOptions;
try {
  sslOptions = {
    key: fs.readFileSync(path.join(__dirname, '../privkey.pem')),
    cert: fs.readFileSync(path.join(__dirname, '../fullchain.pem'))
  };
  console.log('✅ SSL certificates loaded successfully');
} catch (err) {
  console.error('❌ Error loading SSL certificates:', err.message);
  console.warn('⚠️ Falling back to HTTP (not secure)');
}

// Create server (HTTPS if certificates are available, HTTP as fallback)
var server = sslOptions 
  ? https.createServer(sslOptions, app) 
  : http.createServer(app);

/**
 * Set up Socket.io
 */
const { initializeSocket } = require('../Socket/socketManager');
initializeSocket(server);

/**
 * Listen on provided port, on all network interfaces.
 */
server.listen(port, () => {
   console.log(`🚀 Server running on ${sslOptions ? 'HTTPS' : 'HTTP'} port ${port}`);
   console.log(`💡 Socket.IO endpoint: ${sslOptions ? 'wss' : 'ws'}://localhost:${port}`);
});
server.on('error', onError);
server.on('listening', onListening);

/**
 * Normalize a port into a number, string, or false.
 */
function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

/**
 * Event listener for HTTP server "error" event.
 */
function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof port === 'string'
    ? 'Pipe ' + port
    : 'Port ' + port;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

/**
 * Event listener for HTTP server "listening" event.
 */
function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  debug('Listening on ' + bind);
}
